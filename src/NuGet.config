<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local offline NuGet packages repository -->
    <add key="offline" value=".\nuget-packages" />
    <!-- Production packages from NuGet.org (for reference during development) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <!-- Force all packages to use the offline repository first -->
    <packageSource key="offline">
      <!-- Production packages (must be in offline cache for air-gapped deployment) -->
      <package pattern="System.IdentityModel.Tokens.Jwt" />
      <package pattern="Microsoft.IdentityModel.*" />
      <package pattern="Microsoft.AspNetCore.*" />
      <package pattern="Microsoft.Extensions.*" />
      <package pattern="Microsoft.EntityFrameworkCore*" />
      <package pattern="Microsoft.NET.*" />
      <package pattern="Confluent.Kafka" />
      <package pattern="Npgsql" />
      <package pattern="FlywayDB.*" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="Serilog*" />
      <!-- Test packages (required for offline testing) -->
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="Moq" />
      <package pattern="FluentAssertions" />
    </packageSource>

    <packageSource key="nuget.org">
      <!-- Fallback packages not in offline cache (development only) -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <!-- Disable automatic package source discovery -->
    <add key="enablePackageSourceMapping" value="true" />
  </config>
</configuration>
