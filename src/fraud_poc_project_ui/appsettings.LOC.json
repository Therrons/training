{
  "AppSettings": {
    "ApplicationName": "fraud_poc",
    "CORS": {
      "enabled": true,
      "origins": [
        "http://localhost:3000",
        "http://localhost:3001",
        "http://localhost:3002",
        "http://localhost:3003",
        "http://localhost:3004",
        "http://localhost:3005"
      ]
    },
    "GroupId": "poc-fraud-dev-consumer-group"
  },
  "AWSRegion": "af-south-1",
  "AWSSecretName": "credit-plrcre-npr/fraud_poc_project_K8s/dev",
  "Database": {
    "ConnectionStringReadWrite": "Server=localhost;User Id={user};Password={pwd};Pooling=true;Connection Lifetime=0;SSLMode=Require;Trust Server Certificate=true;",
    "CreateDatabaseOnStartup": "false",
    "DBSchema": "fr",
    "FailureRefreshInterval": 30,
    "ScriptsFolder": "database",
    "SuccessRefreshInterval": 10,
    "UseRdsToken": false
  },
  "KafkaAdminOptions": {
    "TopicOptions": [
      {
        "Partitions": 1,
        "ReplicationFactor": 1,
        "Topic": "poc-fraud-dev"
      },
      {
        "Partitions": 1,
        "ReplicationFactor": 1,
        "Topic": "poc-fraud-dev-dlt"
      }
    ]
  },
  "KafkaSettings": {
    "BrokerSettings": {
      "AllowAutoCreateTopics": "false",
      "BootstrapServers": "localhost:9094",
      "SaslMechanism": "ScramSha256",
      "SaslPassword": "kafka-admin-pass",
      "SaslUserName": "kafka-admin",
      "SecurityProtocol": "SaslPlaintext"
    },
    "ConsumerSettings": {
      "TransactionTopic": "poc-fraud-dev",
      "TransactionTopicDtl": "poc-fraud-dev-dtl",
      "AutoOffsetReset": "Earliest",
      "PartitionAssignmentStrategy": "RoundRobin",
      "MaxPollIntervalMs": 300000,
      "SessionTimeoutMs": 45000,
      "Concurrency": 1,
      "SequentialProcessing": "true",
      "BatchSize": 5,
      "BatchProcessTimeout": 5,
      "ConsumeMessageIntervalMs": 100,
      "FetchMaxBytes": 52428800,
      "FetchMinBytes": 1024
    },
    "ProducerSettings": {
      "CompressionType": "Snappy",
      "EnableIdempotence": "false",
      "LingerMs": 10,
      "MessageTimeoutMs": 30000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}