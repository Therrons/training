{
  "AppSettings": {
    "ApplicationName": "fraud_poc",
    "CORS": {
      "enabled": true,
      "origins": [
        "http://localhost:3000",
        "http://localhost:3001",
        "http://localhost:3002",
        "http://localhost:3003",
        "http://localhost:3004",
        "http://localhost:3005"
      ]
    },
    "GroupId": "poc-fraud-dev-consumer-group"
  },
  "Database": {
    "ConnectionStringReadWrite": "Server={host};User Id={user};Password={pwd};Pooling=true;Maximum Pool Size=50;Minimum Pool Size=10;Connection Idle Lifetime=300;Connection Reuse Strategy=Lifo;SSLMode=Disable;Trust Server Certificate=true;",
    "CreateDatabaseOnStartup": "true",
    "DBSchema": "fr",
    "FailureRefreshInterval": 30,
    "ScriptsFolder": "database",
    "SuccessRefreshInterval": 10,
    "Host": "postgres"
  },
  "JwtSettings": {
    "Secret": "your-super-duper-secret-key-of-min-32-characters-long",
    "Issuer": "fraud-poc-api",
    "Audience": "fraud-poc-api-client",
    "ExpirationMinutes": 60
  },
  "KafkaAdminOptions": {
    "TopicOptions": [
      {
        "Partitions": 1,
        "ReplicationFactor": 1,
        "Topic": "poc-fraud-dev"
      },
      {
        "Partitions": 1,
        "ReplicationFactor": 1,
        "Topic": "poc-fraud-dev-dlt"
      }
    ]
  },
  "KafkaSettings": {
    "BrokerSettings": {
      "AllowAutoCreateTopics": "false",
      "BootstrapServers": "kafka:9092",
      "SaslMechanism": "Plain",
      "SaslPassword": "",
      "SaslUserName": "",
      "SecurityProtocol": "Plaintext"
    },
    "ConsumerSettings": {
      "TransactionTopic": "poc-fraud-dev",
      "TransactionTopicDtl": "poc-fraud-dev-dtl",
      "AutoOffsetReset": "Earliest",
      "PartitionAssignmentStrategy": "RoundRobin",
      "MaxPollIntervalMs": 300000,
      "SessionTimeoutMs": 45000,
      "Concurrency": 1,
      "SequentialProcessing": "false",
      "StartWorkerRetry": 5,
      "BatchSize": 5,
      "BatchProcessTimeout": 5,
      "ConsumeMessageIntervalMs": 10,
      "FetchMaxBytes": 52428800,
      "FetchMinBytes": 1024
    },
    "ProducerSettings": {
      "CompressionType": "Snappy",
      "EnableIdempotence": "false",
      "LingerMs": 10,
      "MessageTimeoutMs": 30000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
