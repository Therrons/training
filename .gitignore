################################################################################
# This .gitignore file was automatically created by Microsoft(R) Visual Studio.
################################################################################

# Build output — every project's bin/obj anywhere in the repo
**/[Bb]in/
**/[Oo]bj/

# Visual Studio cache/settings folders
**/.vs/

# Certificates — never commit
/certs/*.cer
/certs/*.crt
/certs/*.pem
/src/CapitecRootCA.cer
/src/CapitecRootCA.crt
/src/CapitecRootCA.pem

# Local secrets — never commit
.env

# Terraform — never commit state, lock, or real var files
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
terraform.tfvars

# RooCode files
.roomodes
.roo/

# Keep memory bank files
!memory-bank/
!memory-bank/*.md

# Misc
/src/Kafka/src/nuget-packages
/.claude-flow
